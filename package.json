{
  "name": "ikimetr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level high",
    "build": "pnpm run build:packages && pnpm --filter './apps/**' build",
    "build:packages": "pnpm --filter './packages/**' --if-present build",
    "compose:config": "docker compose --env-file .env.example -f infrastructure/compose.yaml config --quiet",
    "db:migrate:create": "pnpm --filter @ikimetr/database db:migrate:create",
    "db:migrate:down:local": "pnpm --filter @ikimetr/database db:migrate:down:local",
    "db:migrate:up": "pnpm --filter @ikimetr/database db:migrate:up",
    "db:migrate:verify": "pnpm --filter @ikimetr/database db:migrate:verify",
    "dev": "pnpm run build:packages && pnpm --parallel --filter './apps/**' dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose --env-file .env.example -f infrastructure/compose.yaml down",
    "infra:up": "docker compose --env-file .env.example -f infrastructure/compose.yaml up -d --wait",
    "lint": "eslint .",
    "test": "pnpm run test:unit",
    "test:integration": "pnpm run build:packages && vitest run --config vitest.integration.config.ts",
    "test:unit": "pnpm run build:packages && vitest run --config vitest.config.ts",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@ikimetr/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
